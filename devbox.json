{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "python@3.12",
    "uv@latest",
    "git@latest"
  ],
  "env": {
    "UV_TOOL_DIR": "$DEVBOX_PROJECT_ROOT/.devbox/uv/tools",
    "UV_TOOL_BIN_DIR": "$DEVBOX_PROJECT_ROOT/.devbox/uv/bin",
    "PATH": "$DEVBOX_PROJECT_ROOT/.devbox/uv/bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "test -x \"$UV_TOOL_BIN_DIR/specify\" || uv tool install specify-cli"
    ],
    "scripts": {
      "check": ["specify check"]
    }
  }
}
