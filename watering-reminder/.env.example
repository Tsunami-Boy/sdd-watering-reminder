# Copy to .env for local use. Never commit .env. In production set these in Render's dashboard.
BOT_TOKEN=replace-with-token-from-botfather
DATABASE_URL=postgresql://waterbot:waterbot@localhost:5432/waterbot
TEST_DATABASE_URL=postgresql://waterbot:waterbot@localhost:5432/waterbot_test
RUN_MODE=polling
# Webhook mode only (production). Use 32+ random characters for the two secrets.
WEBHOOK_SECRET=replace-with-random-string
WEBHOOK_SECRET_TOKEN=replace-with-random-string
RENDER_EXTERNAL_URL=
PORT=8000
# Testing only: shifts the bot clock forward so you don't wait for 08:00. Keep 0 in production.
CLOCK_OFFSET_HOURS=0
